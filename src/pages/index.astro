---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Hero from '../components/home/Hero.astro';
import Manifesto from '../components/home/Manifesto.astro';
import ClientLogos from '../components/home/ClientLogos.astro';
import Services from '../components/home/Services.astro';
import Team from '../components/home/Team.astro';
import Commitments from '../components/home/Commitments.astro';
import FinalCta from '../components/home/FinalCta.astro';
import equipe from '../assets/images/equipe.jpg';
import logo from '../assets/brand/logo-noir.png';
import { SITE } from '../data/site';

// Title and description keep the intent of the current WordPress homepage.
const title = 'Les Drones Lyonnais, pilotes de drone à Lyon | Prestations, formations, vente et location';
const description =
  'Les Drones Lyonnais : prestations par drone à Lyon, formations professionnelles, vente de matériel et location de drones pour particuliers et entreprises.';

const social = await getImage({ src: equipe, width: 1200, height: 630, format: 'jpg', fit: 'cover', position: 'right' });
const logoImage = await getImage({ src: logo, width: 600, format: 'png' });
const abs = (path: string) => new URL(path, SITE.url).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE.url}/#organisation`,
  name: SITE.name,
  url: `${SITE.url}/`,
  logo: abs(logoImage.src),
  image: abs(social.src),
  telephone: '+33412240387',
  email: SITE.email,
  address: { '@type': 'PostalAddress', addressLocality: SITE.city, addressCountry: 'FR' },
  areaServed: { '@type': 'Country', name: 'France' },
  sameAs: SITE.social.map((s) => s.href),
};
---

<BaseLayout title={title} description={description} image={abs(social.src)} headerOverlay headerCompact>
  <JsonLd slot="head" data={organization} />
  <div class="dive">
    <Hero />
  </div>
  <!-- The rest of the page, revealed through the hero's lens. -->
  <div class="after-dive bg-ink">
    <Manifesto />
    <ClientLogos />
    <Services />
    <Team />
    <Commitments />
    <FinalCta />
  </div>
</BaseLayout>

<style>
  /* Through the lens: the hero stays pinned for one screen of scrolling while its lens
     opens; the page sits right behind it and holds still (translate cancels the scroll)
     until the opening is complete, then scrolls on normally. Without scroll-driven
     animations, or with reduced motion, the page simply follows the hero. */
  .dive {
    position: relative;
    z-index: 2;
  }
  .after-dive {
    position: relative;
    z-index: 1;
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .dive {
        height: 200svh;
      }
      .after-dive {
        margin-top: -100svh;
        animation-name: hold;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 100svh;
      }
    }
  }
  @keyframes hold {
    from {
      translate: 0 -100svh;
    }
    to {
      translate: 0 0;
    }
  }
</style>
