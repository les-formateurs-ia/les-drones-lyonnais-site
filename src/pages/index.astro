---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Hero from '../components/home/Hero.astro';
import ClientLogos from '../components/home/ClientLogos.astro';
import Services from '../components/home/Services.astro';
import Team from '../components/home/Team.astro';
import Commitments from '../components/home/Commitments.astro';
import FinalCta from '../components/home/FinalCta.astro';
import equipe from '../assets/images/equipe.jpg';
import logo from '../assets/brand/logo-noir.png';
import { SITE } from '../data/site';

// Title and description keep the intent of the current WordPress homepage.
const title = 'Les Drones Lyonnais, pilotes de drone à Lyon | Prestations, formations, vente et location';
const description =
  'Les Drones Lyonnais : prestations par drone à Lyon, formations professionnelles, vente de matériel et location de drones pour particuliers et entreprises.';

const social = await getImage({ src: equipe, width: 1200, height: 630, format: 'jpg', fit: 'cover', position: 'right' });
const logoImage = await getImage({ src: logo, width: 600, format: 'png' });
const abs = (path: string) => new URL(path, SITE.url).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE.url}/#organisation`,
  name: SITE.name,
  url: `${SITE.url}/`,
  logo: abs(logoImage.src),
  image: abs(social.src),
  telephone: '+33412240387',
  email: SITE.email,
  address: { '@type': 'PostalAddress', addressLocality: SITE.city, addressCountry: 'FR' },
  areaServed: { '@type': 'Country', name: 'France' },
  sameAs: SITE.social.map((s) => s.href),
};
---

<BaseLayout title={title} description={description} image={abs(social.src)}>
  <JsonLd slot="head" data={organization} />
  <Hero />
  <ClientLogos />
  <Services />
  <Team />
  <Commitments />
  <FinalCta />
</BaseLayout>
