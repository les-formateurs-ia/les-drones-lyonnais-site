---
// /prestations/ — the hub of the drone services, rebuilt from the current page:
// technical or artistic choice, both catalogues, the five-step method, quote request.
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import DeckHero, { type DeckFamily } from '../components/ui/DeckHero.astro';
import { servicePhoto } from '../lib/service-photo';
import dylan from '../assets/team/dylan-pied.webp';
import theo from '../assets/team/theo-pied.webp';
import ServiceCatalog from '../components/prestations/ServiceCatalog.astro';
import Method from '../components/prestations/Method.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { SERVICES, FAMILIES, PROMISES, SENSOR_LABEL, servicesOf } from '../data/services';
import { ACTIVITIES } from '../data/site';
import { SITE } from '../data/site';

// Title and description keep the intent of the current WordPress page.
const title = 'Prestations drone et audiovisuelles à Lyon | Les Drones Lyonnais';
const description =
  'Inspection, modélisation 3D, prises de vues aériennes et production vidéo : découvrez nos prestations à Lyon et en France. Présentez-nous votre projet.';
const pageUrl = `${SITE.url}/prestations/`;

const families: DeckFamily[] = await Promise.all(
  (['technique', 'artistique'] as const).map(async (id) => ({
    label: id === 'technique' ? 'Technique' : 'Artistique',
    guide: id === 'technique' ? { photo: dylan, alt: 'Dylan, fondateur des Drones Lyonnais' } : { photo: theo, alt: 'Théo, responsable audiovisuel et formation' },
    title: FAMILIES[id].title,
    tagline: FAMILIES[id].tagline,
    cards: await Promise.all(
      servicesOf(id).map(async (s) => ({ href: s.href, label: s.label, summary: s.summary, tag: SENSOR_LABEL[s.sensor], photo: await servicePhoto(s.image, 4 / 5) })),
    ),
  })),
);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Prestations', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Prestations drone et audiovisuelles',
    itemListElement: SERVICES.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.label,
      url: new URL(s.href, SITE.url).href,
    })),
  },
];
---

<BaseLayout title={title} description={description} headerOverlay>
  {structuredData.map((data) => <JsonLd slot="head" data={data} />)}
  <DeckHero
    crumb="Prestations"
    title="Prestations drone et audiovisuelles"
    lead="L’art de capturer l’essentiel, à Lyon et partout en France."
    color={ACTIVITIES.prestations.color}
    noun="prestations"
    families={families}
    promises={PROMISES}
  />
  <ServiceCatalog family="technique" />
  <ServiceCatalog family="artistique" dark />
  <Method />
  <FinalCta title="Besoin d’une solution sur mesure ?" text="Parlez-nous de votre projet : nous revenons vers vous avec une proposition et un devis détaillé." />
</BaseLayout>
