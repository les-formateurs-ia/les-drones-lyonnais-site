---
// /prestations/ opening. Same choice as the current page — technical or artistic — made
// big: two panels that lead to their family; pointing at one switches the picture
// behind (thermal inspection or cinema). Dylan stands in front, as on the current page.
import { Image } from 'astro:assets';
import dylan from '../../assets/team/dylan-pied.webp';
import Square from '../ui/Square.astro';
import SensorFilters from '../ui/SensorFilters.astro';
import { servicePhoto } from '../../lib/service-photo';
import { FAMILIES, PROMISES, servicesOf, type ServiceFamily } from '../../data/services';
import { ACTIVITIES } from '../../data/site';

const families: { id: ServiceFamily; photo: string; sensor: string }[] = [
  { id: 'technique', photo: 'inspection-thermique.jpg', sensor: 'thermal' },
  { id: 'artistique', photo: 'cinema.jpg', sensor: 'cine' },
];
const backdrops = await Promise.all(families.map(async (f) => ({ ...f, ...(await servicePhoto(f.photo)) })));
---

<section class="presta-hero" aria-labelledby="presta-title" data-family="technique">
  <div class="backdrops" aria-hidden="true">
    {
      backdrops.map((b, i) => (
        <img
          class="backdrop"
          data-backdrop={b.id}
          src={b.src}
          srcset={b.srcset}
          sizes="100vw"
          alt=""
          fetchpriority={i === 0 ? 'high' : 'auto'}
          loading={i === 0 ? 'eager' : 'lazy'}
        />
      ))
    }
    <div class="veil"></div>
  </div>

  <div class="frame viewfinder" aria-hidden="true"></div>

  <div class="wrap content">
    <div class="intro">
      <nav aria-label="Fil d’Ariane" class="hud-text crumbs">
        <a href="/">Accueil</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Prestations</span>
      </nav>
      <h1 id="presta-title" class="display mt-6 flex items-start gap-4 text-[clamp(2.6rem,6vw,5.6rem)]">
        <Square color={ACTIVITIES.prestations.color} class="mt-[0.18em] size-[0.28em] shrink-0" />
        Prestations drone et audiovisuelles
      </h1>
      <p class="mt-6 max-w-[40ch] text-xl leading-relaxed text-white/80">
        L’art de capturer l’essentiel, à Lyon et partout en France : des données précises pour vos ouvrages, des images fortes pour vos projets.
      </p>

      <ul class="choices" aria-label="Deux familles de prestations">
        {
          families.map((f) => (
            <li>
              <a href={`#${f.id}`} class="choice" data-choice={f.id}>
                <span class="choice-title">{f.id === 'technique' ? 'Technique' : 'Artistique'}</span>
                <span class="choice-text">{FAMILIES[f.id].tagline}</span>
                <span class="choice-count hud-text">{servicesOf(f.id).length} prestations</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <Image src={dylan} alt="Dylan, fondateur des Drones Lyonnais, bras croisés" widths={[360, 540, 720]} sizes="(min-width: 1024px) 30vw, 0px" class="dylan" loading="eager" />
  </div>

  <ul class="promises wrap" aria-label="Nos engagements">
    {
      PROMISES.map((p) => (
        <li>
          <Square color="var(--color-gold)" />
          <span>
            <strong>{p.title}</strong>
            <span class="text-white/65"> {p.text}</span>
          </span>
        </li>
      ))
    }
  </ul>
  <SensorFilters />
</section>

<style>
  .presta-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: max(100svh, 720px);
    overflow: hidden;
    background: #000;
    color: #fff;
  }

  /* ---------- Backdrop: one picture per family ---------- */
  .backdrops {
    position: absolute;
    inset: 0;
  }
  .backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 700ms var(--ease-out-strong),
      transform 1400ms var(--ease-out-strong);
  }
  .backdrop[data-backdrop='technique'] {
    filter: url(#sensor-thermal);
  }
  .presta-hero[data-family='technique'] [data-backdrop='technique'],
  .presta-hero[data-family='artistique'] [data-backdrop='artistique'] {
    opacity: 1;
    transform: scale(1);
  }
  .veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.85), rgb(0 0 0 / 0.55) 55%, rgb(0 0 0 / 0.25)),
      linear-gradient(rgb(0 0 0 / 0.5), rgb(0 0 0 / 0) 30%, rgb(0 0 0 / 0) 60%, rgb(0 0 0 / 0.85));
  }
  .frame {
    position: absolute;
    inset: 92px clamp(16px, 3vw, 40px) 24px;
    --vf-inset: 0px;
    --vf-size: 28px;
    pointer-events: none;
  }

  /* ---------- Content ---------- */
  .content {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 7fr 5fr;
    align-items: end;
    gap: 32px;
    padding-top: 140px;
  }
  .intro {
    padding-bottom: 40px;
  }
  .crumbs {
    display: flex;
    gap: 10px;
    color: rgb(255 255 255 / 0.65);
  }
  .crumbs a:hover {
    color: #fff;
  }

  .choices {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    margin-top: 40px;
    max-width: 640px;
  }
  .choice {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 22px 24px 20px;
    background: rgb(0 0 0 / 0.45);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: background-color 300ms ease;
  }
  .choice::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 400ms var(--ease-out-strong);
  }
  .choice-title {
    font-size: clamp(1.6rem, 2.4vw, 2.2rem);
    font-weight: 700;
    font-stretch: 118%;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .choice-text {
    color: rgb(255 255 255 / 0.8);
  }
  .choice-count {
    margin-top: 6px;
    color: var(--color-gold);
  }
  .presta-hero[data-family='technique'] [data-choice='technique'],
  .presta-hero[data-family='artistique'] [data-choice='artistique'] {
    background: rgb(0 0 0 / 0.72);
  }
  .presta-hero[data-family='technique'] [data-choice='technique']::before,
  .presta-hero[data-family='artistique'] [data-choice='artistique']::before {
    transform: scaleX(1);
  }
  .choice:focus-visible {
    outline-color: #fff;
  }

  .dylan {
    justify-self: end;
    width: min(100%, 380px);
    height: auto;
    max-height: 78svh;
    object-fit: contain;
    object-position: bottom;
    margin-bottom: -2px;
    /* The photo stops at the hips and fades into the promises bar. */
    mask-image: linear-gradient(#000 70%, transparent 98%);
  }

  .promises {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding-block: 22px 40px;
    border-top: 1px solid rgb(255 255 255 / 0.15);
  }
  .promises li {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  @media (max-width: 1023px) {
    .content {
      grid-template-columns: 1fr;
      padding-top: 120px;
    }
    .dylan {
      display: none;
    }
    .promises {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
  @media (max-width: 560px) {
    .choices {
      grid-template-columns: 1fr;
    }
  }

  /* Opening: the words rise in, then Dylan. */
  @media (prefers-reduced-motion: no-preference) {
    .intro > *,
    .promises li {
      animation: rise 800ms var(--ease-out-strong) backwards;
    }
    .intro > :nth-child(2) {
      animation-delay: 80ms;
    }
    .intro > :nth-child(3) {
      animation-delay: 160ms;
    }
    .intro > :nth-child(4) {
      animation-delay: 240ms;
    }
    .dylan {
      animation: rise 1000ms var(--ease-out-strong) 200ms backwards;
    }
    .promises li {
      animation-delay: 420ms;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .backdrop {
      transition: opacity 300ms ease;
      transform: none;
    }
  }
</style>

<script>
  // Pointing at (or focusing) a family shows its picture.
  const hero = document.querySelector<HTMLElement>('.presta-hero');
  hero?.querySelectorAll<HTMLElement>('[data-choice]').forEach((choice) => {
    const pick = () => (hero.dataset.family = choice.dataset.choice);
    choice.addEventListener('pointerenter', pick);
    choice.addEventListener('focus', pick);
  });
</script>
