---
// One family of services as a grid of identical cards (16:10 photo, sensor, title,
// summary). Photos are black and white at rest and take their colours back under the
// pointer — or once revealed on touch screens, where there is no pointer.
import SectionHeader from '../ui/SectionHeader.astro';
import { servicePhoto } from '../../lib/service-photo';
import { FAMILIES, SENSOR_LABEL, servicesOf, type ServiceFamily } from '../../data/services';
import { ACTIVITIES } from '../../data/site';

interface Props {
  family: ServiceFamily;
  dark?: boolean;
}
const { family, dark = false } = Astro.props;
const info = FAMILIES[family];
const cards = await Promise.all(servicesOf(family).map(async (s) => ({ ...s, photo: await servicePhoto(s.image) })));
---

<section id={family} aria-labelledby={`${family}-title`} class:list={['catalog section-pad scroll-mt-16', dark ? 'bg-ink text-white' : 'bg-paper']}>
  <div class="wrap">
    <SectionHeader id={`${family}-title`} title={info.title} color={ACTIVITIES.prestations.color} dark={dark}>
      <p class:list={['font-semibold', dark ? 'text-white' : 'text-ink']}>{info.tagline}</p>
      <p class="max-w-[46ch]">{info.description}</p>
    </SectionHeader>

    <ul class="mt-14 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:mt-20 lg:grid-cols-3">
      {
        cards.map((card, i) => (
          <li data-reveal style={{ '--i': i % 3 }}>
            <a href={card.href} class:list={['card', dark && 'card-dark']}>
              <span class="media viewfinder">
                <img
                  src={card.photo.src}
                  srcset={card.photo.srcset}
                  sizes="(min-width: 1024px) 380px, (min-width: 640px) 46vw, 92vw"
                  width={card.photo.width}
                  height={card.photo.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <span class="sensor hud-text">{SENSOR_LABEL[card.sensor]}</span>
              </span>
              <span class="title">{card.label}</span>
              <span class="summary">{card.summary}</span>
              <span class="cue">Découvrir la prestation</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .media {
    --vf-inset: 10px;
    --vf-size: 18px;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #111;
  }
  /* The viewfinder marks appear only on the card being looked at. */
  .media::after {
    opacity: 0;
    transform: scale(1.04);
    transition:
      opacity 300ms ease,
      transform 400ms var(--ease-out-strong);
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition:
      filter 600ms var(--ease-out-strong),
      transform 900ms var(--ease-out-strong);
  }
  .sensor {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 8px;
    color: #fff;
    background: rgb(0 0 0 / 0.6);
  }
  .sensor::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--color-gold);
  }
  .title {
    margin-top: 18px;
    font-size: 1.3rem;
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .summary {
    margin-top: 8px;
    max-width: 40ch;
    line-height: 1.55;
    color: var(--color-ink-soft);
  }
  .card-dark .summary {
    color: rgb(255 255 255 / 0.7);
  }
  .cue {
    margin-top: auto;
    padding-top: 14px;
    width: fit-content;
    font-weight: 600;
    color: var(--color-gold-deep);
    background: linear-gradient(currentColor, currentColor) no-repeat left bottom / 0 1.5px;
    transition: background-size 300ms var(--ease-out-strong);
  }
  .card-dark .cue {
    color: var(--color-gold);
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover .media img {
      filter: none;
      transform: scale(1.04);
    }
    .card:hover .media::after {
      opacity: 1;
      transform: none;
    }
    .card:hover .cue {
      background-size: 100% 1.5px;
    }
  }
  .card:focus-visible .media img {
    filter: none;
  }
  .card:focus-visible .media::after {
    opacity: 1;
    transform: none;
  }
  /* Touch screens: colour comes back as each card scrolls into view. */
  @media (hover: none) {
    :global([data-reveal].is-in) .media img {
      filter: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .media img,
    .media::after {
      transition: filter 300ms ease;
      transform: none !important;
    }
  }
</style>
