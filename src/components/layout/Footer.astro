---
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-blanc-or.png';
import pop from '../../assets/team/pop-pouce.png';
import Square from '../ui/Square.astro';
import { NAV, SITE, LEGAL } from '../../data/site';

const year = new Date().getFullYear();
// The shop's black square would vanish on the black footer.
const squareColor = (id: string, color: string) => (id === 'boutique' ? 'var(--color-paper)' : color);
---

<footer class="relative overflow-hidden border-t border-white/10 bg-ink text-white">
  <div class="wrap grid gap-12 py-14 md:grid-cols-12 md:py-16">
    <div class="md:col-span-5">
      <Image src={logo} alt={SITE.name} height={44} densities={[1, 2]} class="h-11 w-auto" />
      <p class="mt-6 max-w-[36ch] leading-relaxed text-white/65">
        Pilotes de drone à {SITE.city} : prestations, formations, vente et location de matériel, partout en France.
      </p>
    </div>

    <nav aria-label="Activités" class="md:col-span-3">
      <ul class="flex flex-col gap-3">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="flex items-center gap-3 text-white/85 hover-fine:text-white">
                <Square color={squareColor(item.id, item.color)} />
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={SITE.contactPath} class="flex items-center gap-3 text-white/85 hover-fine:text-white">
            <Square color="var(--color-gold)" />
            Contact
          </a>
        </li>
      </ul>
    </nav>

    <div class="flex flex-col gap-3 md:col-span-4">
      <a href={SITE.phoneHref} class="text-lg font-semibold tabular-nums hover-fine:text-gold">{SITE.phone}</a>
      <a href={`mailto:${SITE.email}`} class="text-white/85 hover-fine:text-white">{SITE.email}</a>
      <ul class="mt-3 flex gap-5">
        {
          SITE.social.map((s) => (
            <li>
              <a href={s.href} class="text-white/65 hover-fine:text-white" rel="noopener" target="_blank">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="wrap relative flex flex-col gap-3 border-t border-white/10 py-6 pr-28 text-sm text-white/50 md:flex-row md:items-center md:gap-8">
    <p>© {year} {SITE.name}</p>
    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      {
        LEGAL.map((l) => (
          <li>
            <a href={l.href} class="hover-fine:text-white">{l.label}</a>
          </li>
        ))
      }
    </ul>
    <!-- Pop signs off. -->
    <Image src={pop} alt="" width={96} densities={[1, 2]} class="pointer-events-none absolute right-[clamp(16px,4.5vw,56px)] bottom-0 w-20 md:w-24" />
  </div>
</footer>
