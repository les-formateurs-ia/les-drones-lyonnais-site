---
// Right under the hero: what the chosen mode is about, with four real offers (services,
// drones for sale, rental packs or trainings). All four versions are in the HTML; the
// page shows the one of the current mode (html[data-mode], see lib/mode.ts).
import Square from '../ui/Square.astro';
import { MODE_LIST, FOCUS } from '../../data/modes';
import { formatPrice, productUrl, forSale, forRent } from '../../data/catalog';
import { LEVEL_LABEL, FORMATIONS } from '../../data/formations';
import { SERVICES } from '../../data/services';
import { servicePhoto, type ServicePhoto } from '../../lib/service-photo';
import { productPhoto } from '../../lib/product-photo';
import type { ActivityId } from '../../data/site';

interface Card {
  title: string;
  meta: string;
  text: string;
  href: string;
  photo: ServicePhoto | null;
  /** Product shots are on white: shown whole, not cropped. */
  product?: boolean;
}

const RATIO = 4 / 3;

// The section's goal is the click to the full page: the button names what is waiting there.
const total: Record<ActivityId, { n: number; what: string; verb: string }> = {
  prestations: { n: SERVICES.length, what: 'prestations', verb: 'Découvrir les' },
  boutique: { n: forSale.length, what: 'produits en boutique', verb: 'Voir les' },
  location: { n: forRent.length, what: 'drones et packs à louer', verb: 'Voir les' },
  formations: { n: FORMATIONS.length, what: 'formations', verb: 'Découvrir les' },
};
const cards: Record<ActivityId, Card[]> = {
  prestations: await Promise.all(
    FOCUS.prestations.map(async (s) => ({
      title: s.label,
      meta: s.family === 'technique' ? 'Prestation technique' : 'Prestation artistique',
      text: s.summary,
      href: s.href,
      photo: await servicePhoto(s.image, RATIO),
    })),
  ),
  boutique: await Promise.all(
    FOCUS.boutique.map(async (p) => ({
      title: p.name,
      meta: `${formatPrice(p.priceTTC)} TTC`,
      text: p.summary,
      href: productUrl(p),
      photo: await productPhoto(p, RATIO),
      product: true,
    })),
  ),
  location: await Promise.all(
    FOCUS.location.map(async (p) => ({
      title: p.name,
      meta: `${formatPrice(p.priceTTC)} TTC / jour`,
      text: p.summary,
      href: productUrl(p),
      photo: await productPhoto(p, RATIO),
      product: true,
    })),
  ),
  formations: await Promise.all(
    FOCUS.formations.map(async (f) => ({
      title: f.title,
      meta: `${LEVEL_LABEL[f.level]} · ${f.duration}`,
      text: f.scope,
      href: '/formations-drone-a-lyon/',
      photo: await servicePhoto(f.image, RATIO),
    })),
  ),
};
---

<section class="focus section-pad bg-ink text-white" aria-label="Notre offre">
  <div class="wrap">
    {
      MODE_LIST.map((m) => (
        <div data-for={m.id}>
          <div class="head">
            <div>
              <p class="kicker hud-text" style={{ '--i': 0 }}>
                <Square color="var(--accent)" class="size-[9px]" />
                {m.label}
              </p>
              {/* Hidden modes are display: none, so only one of these h2 is ever read. */}
              <h2 class="title display" style={{ '--i': 1 }}>
                {m.focus.title}
              </h2>
            </div>
            <div class="head-side" style={{ '--i': 2 }}>
              <p class="intro">{m.focus.text}</p>
              <a class="more" href={m.focus.more.href}>
                {m.focus.more.label}
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          <ul class="cards">
            {cards[m.id].map((c, i) => (
              <li style={{ '--i': i + 3 }}>
                <a class="card" href={c.href}>
                  <span class:list={['card-img', c.product && 'is-product']}>
                    {c.photo && <img src={c.photo.src} srcset={c.photo.srcset} sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 90vw" alt="" loading="lazy" decoding="async" width={c.photo.width} height={c.photo.height} />}
                  </span>
                  <span class="card-meta hud-text">{c.meta}</span>
                  <span class="card-title">{c.title}</span>
                  <span class="card-text">{c.text}</span>
                  <span class="card-go" aria-hidden="true">
                    Voir <span class="arrow">→</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>

          {/* Main call to action: the full page of the mode. */}
          <a class="go" href={m.href} style={{ '--i': 8 }}>
            <span class="go-count" aria-hidden="true">
              <b>{total[m.id].n}</b>
            </span>
            <span class="go-text">
              <span class="go-kicker hud-text">Ce n’est qu’un aperçu</span>
              <span class="go-title">
                {total[m.id].verb} {total[m.id].n} {total[m.id].what}
              </span>
            </span>
            <span class="go-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
          </a>
        </div>
      ))
    }
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: 24px 64px;
    align-items: end;
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  @media (min-width: 1024px) {
    .head {
      grid-template-columns: 1.2fr 1fr;
    }
  }
  .kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.7);
  }
  .title {
    margin-top: 16px;
    font-size: clamp(2rem, 4vw, 3.4rem);
  }
  .intro {
    max-width: 44ch;
    font-size: 17px;
    line-height: 1.55;
    color: rgb(255 255 255 / 0.7);
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
    padding: 12px 20px;
    font-weight: 700;
    color: #fff;
    border: 1px solid color-mix(in srgb, var(--accent) 70%, transparent);
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    transition: background-color 250ms ease;
  }
  .arrow {
    display: inline-block;
    transition: transform 250ms var(--ease-out-strong);
  }
  @media (hover: hover) and (pointer: fine) {
    .more:hover {
      background: color-mix(in srgb, var(--accent) 34%, transparent);
    }
    .more:hover .arrow,
    .card:hover .arrow {
      transform: translateX(4px);
    }
  }
  .more:focus-visible,
  .go:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 3px;
  }

  .cards {
    display: grid;
    gap: 2px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
  }
  @media (min-width: 1024px) {
    .cards {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 12px 12px 22px;
    background: rgb(255 255 255 / 0.04);
    border-top: 2px solid transparent;
    transition:
      background-color 250ms ease,
      border-color 250ms ease;
  }
  .card-img {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #111;
  }
  .card-img.is-product {
    background: #fff;
  }
  .card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition:
      filter 400ms ease,
      transform 900ms var(--ease-out-strong);
  }
  .card-img.is-product img {
    object-fit: contain;
    filter: none;
  }
  .card-meta {
    margin-top: 18px;
    text-transform: uppercase;
    color: var(--accent);
  }
  .card-title {
    margin-top: 8px;
    font-size: 19px;
    font-weight: 700;
    font-stretch: 110%;
    line-height: 1.2;
  }
  .card-text {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.62);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      background: rgb(255 255 255 / 0.08);
      border-top-color: var(--accent);
    }
    .card:hover .card-img img {
      filter: none;
      transform: scale(1.04);
    }
  }
  .card-go {
    margin-top: auto;
    padding-top: 16px;
    font-weight: 700;
    font-size: 15px;
    color: var(--accent);
  }

  /* ---------- Main call to action ---------- */
  .go {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
    margin-top: 2px;
    padding: clamp(20px, 3vw, 32px) clamp(20px, 3vw, 40px);
    overflow: hidden;
    /* Text on the accent fill: white, except on the white accent of the shop. */
    --on-accent: #fff;
    color: #fff;
    background: color-mix(in srgb, var(--accent) 22%, #0b0b0b);
    border-top: 2px solid var(--accent);
  }
  /* Fill that sweeps across on hover, plus a slow light pass to draw the eye. */
  .go::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 600ms var(--ease-out-strong);
  }
  .go::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    z-index: -1;
    width: 30%;
    background: linear-gradient(100deg, transparent, rgb(255 255 255 / 0.12), transparent);
    transform: translateX(-120%);
    pointer-events: none;
  }
  :global(html[data-mode='boutique']) .go {
    --on-accent: #000;
  }
  .go-count {
    display: grid;
    place-items: center;
    min-width: 2.4em;
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
    transition: color 300ms ease;
  }
  .go-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .go-kicker {
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.65);
  }
  .go-title {
    font-size: clamp(1.25rem, 2.4vw, 2rem);
    font-weight: 700;
    font-stretch: 115%;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .go-arrow {
    display: grid;
    place-items: center;
    width: clamp(52px, 6vw, 72px);
    aspect-ratio: 1;
    border-radius: 50%;
    color: #000;
    background: #fff;
    transition:
      transform 400ms var(--ease-out-strong),
      color 300ms ease,
      background-color 300ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .go:hover::before {
      transform: scaleX(1);
    }
    .go:hover {
      color: var(--on-accent);
    }
    .go:hover .go-count,
    .go:hover .go-kicker {
      color: inherit;
    }
    .go:hover .go-arrow {
      color: var(--accent);
      background: var(--on-accent);
      transform: translateX(6px);
    }
  }
  .go:active .go-arrow {
    transform: translateX(6px) scale(0.94);
  }
  @media (prefers-reduced-motion: no-preference) {
    .go::after {
      animation: go-shine 5s ease-in-out 1.5s infinite;
    }
    .go-arrow svg {
      animation: go-nudge 2.4s ease-in-out infinite;
    }
  }
  @keyframes go-shine {
    0%,
    60% {
      transform: translateX(-120%);
    }
    100% {
      transform: translateX(420%);
    }
  }
  @keyframes go-nudge {
    0%,
    70%,
    100% {
      transform: none;
    }
    80% {
      transform: translateX(4px);
    }
    90% {
      transform: translateX(-1px);
    }
  }
  @media (max-width: 640px) {
    .go {
      grid-template-columns: 1fr auto;
    }
    .go-count {
      display: none;
    }
  }

  .card:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 2px;
  }
</style>
