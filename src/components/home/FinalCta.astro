---
import Button from '../ui/Button.astro';
import { SITE } from '../../data/site';
---

<section aria-labelledby="cta-title" class="bg-ink text-white">
  <div class="wrap grid gap-10 py-16 md:py-24 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-7">
      <h2 id="cta-title" class="display text-[clamp(2rem,4.6vw,3.8rem)]">Un projet de tournage, d’inspection ou de formation ?</h2>
      <p class="mt-6 max-w-[48ch] text-lg leading-relaxed text-white/75">
        Décrivez-nous votre besoin : nous revenons vers vous avec une proposition et un devis détaillé.
      </p>
    </div>
    <div class="flex flex-col gap-6 lg:col-span-5 lg:items-end">
      <div class="flex flex-wrap gap-3">
        <Button href={SITE.contactPath} variant="gold">Demander un devis</Button>
        <Button href={SITE.phoneHref} variant="outline-light">{SITE.phone}</Button>
      </div>
      <a href={`mailto:${SITE.email}`} class="text-white/75 underline decoration-white/30 underline-offset-4 hover-fine:text-white hover-fine:decoration-gold">{SITE.email}</a>
    </div>
  </div>
</section>
