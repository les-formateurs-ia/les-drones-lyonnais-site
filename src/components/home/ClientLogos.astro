---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Every logo in assets/clients is shown. Files are named after the client.
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/clients/*.png', { eager: true });

const NAMES: Record<string, string> = {
  aaa: 'Alan Allman Associates',
  'adamis-production': 'Adamis Production',
  'credit-agricole': 'Crédit Agricole',
  'canal-plus': 'Canal+',
  'e-leclerc': 'E.Leclerc',
  'fayat-batiment': 'Fayat Bâtiment',
  'france-frais': 'France Frais',
  'groupe-2-fleuves': 'Groupe 2 Fleuves',
  'la-boutique-officielle': 'La Boutique Officielle',
  'marina-rinaldi': 'Marina Rinaldi',
  'pasino-grand': 'Pasino Grand',
  'saint-jean': 'Saint-Jean',
  cnrs: 'CNRS',
  edf: 'EDF',
  psl: 'Université PSL',
  sncf: 'SNCF',
  tf1: 'TF1',
  c8: 'C8',
};

const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

// Logos have very different shapes. Giving each the same visual area (not the same
// height) keeps a wide wordmark and a square badge at a comparable weight.
const AREA = 2600;
const MAX_HEIGHT = 56;

const logos = Object.entries(files)
  .map(([path, mod]) => {
    const slug = path.split('/').pop()!.replace('.png', '');
    const img = mod.default;
    const ratio = img.width / img.height;
    const height = Math.min(MAX_HEIGHT, Math.sqrt(AREA / ratio));
    return { img, name: NAMES[slug] ?? capitalize(slug), width: Math.round(height * ratio), height: Math.round(height) };
  })
  .sort((a, b) => a.name.localeCompare(b.name, 'fr'));
---

<section aria-labelledby="clients-title" class="wrap py-16 md:py-24">
  <div class="mb-10 flex flex-col gap-3 md:mb-14 md:flex-row md:items-end md:justify-between">
    <h2 id="clients-title" class="display text-[clamp(1.8rem,3.4vw,2.8rem)]">Ils nous font confiance</h2>
    <p class="max-w-[46ch] text-muted">Industriels, groupes de construction, chaînes de télévision et marques : {logos.length} clients nous ont confié leurs projets.</p>
  </div>

  <ul class="grid grid-cols-4 border-t border-l border-line md:grid-cols-6 lg:grid-cols-8">
    {
      logos.map((logo) => (
        <li class="flex h-20 items-center justify-center border-r border-b border-line p-2.5 sm:h-24 sm:p-4 md:h-28">
          <Image
            src={logo.img}
            alt={logo.name}
            width={logo.width}
            height={logo.height}
            densities={[1, 2]}
            class="max-w-full object-contain opacity-75 transition-opacity duration-200 hover-fine:opacity-100"
            style={{ width: `${logo.width}px`, height: 'auto' }}
          />
        </li>
      ))
    }
  </ul>
</section>
