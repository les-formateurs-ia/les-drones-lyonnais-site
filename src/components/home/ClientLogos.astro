---
// Two rows of client logos drifting in opposite directions. Each row's list is
// rendered twice so the loop is seamless; the copy is hidden from assistive tech.
// Reduced motion: a still, wrapped wall of logos.
import { Image } from 'astro:assets';
import SectionHeader from '../ui/SectionHeader.astro';
import { CLIENTS } from '../../data/clients';

const half = Math.ceil(CLIENTS.length / 2);
const rows = [CLIENTS.slice(0, half), CLIENTS.slice(half)];
---

<section aria-labelledby="clients-title" class="expand-in section-pad bg-paper">
  <div class="wrap mb-12 md:mb-16">
    <SectionHeader id="clients-title" title="Ils nous font confiance">
      <p class="max-w-[44ch]">Industriels, groupes de construction, chaînes de télévision et marques : {CLIENTS.length} clients nous ont confié leurs projets.</p>
    </SectionHeader>
  </div>

  <div class="marquee flex flex-col gap-4 md:gap-6">
    {
      rows.map((row, r) => (
        <div class="row" data-direction={r === 0 ? 'left' : 'right'}>
          {[0, 1].map((copy) => (
            <ul class="track" aria-hidden={copy === 1 ? 'true' : undefined}>
              {row.map((logo) => (
                <li class="flex h-20 w-[clamp(120px,14vw,190px)] shrink-0 items-center justify-center px-4">
                  <Image
                    src={logo.img}
                    alt={copy === 1 ? '' : logo.name}
                    width={logo.width}
                    height={logo.height}
                    densities={[1, 2]}
                    class="max-w-full object-contain opacity-70"
                    style={{ width: `${logo.width}px`, height: 'auto' }}
                  />
                </li>
              ))}
            </ul>
          ))}
        </div>
      ))
    }
  </div>
</section>

<style>
  .row {
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .track {
    display: flex;
    flex-shrink: 0;
    animation: drift 60s linear infinite;
  }
  .row[data-direction='right'] .track {
    animation-direction: reverse;
  }
  @media (hover: hover) and (pointer: fine) {
    .row:hover .track {
      animation-play-state: paused;
    }
  }
  @keyframes drift {
    to {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      width: 100%;
      max-width: 1280px;
      margin-inline: auto;
      padding-inline: clamp(16px, 4.5vw, 56px);
    }
    .row {
      mask-image: none;
    }
    .row,
    .track {
      flex-wrap: wrap;
      justify-content: center;
    }
    .track {
      animation: none;
    }
    .track[aria-hidden] {
      display: none;
    }
  }
</style>
