---
// The team photo opens from a framed window to its full width as it scrolls in;
// the people come in one after the other underneath.
import { Image } from 'astro:assets';
import equipe from '../../assets/images/equipe.jpg';
import Portrait from '../ui/Portrait.astro';
import { TEAM, TEAM_INTRO } from '../../data/home';
---

<section aria-labelledby="team-title" class="bg-paper py-20 md:py-32">
  <!-- The photo's left side is an empty studio backdrop: on large screens the intro sits there. -->
  <div class="wrap">
    <div class="relative">
      <div class="z-10 flex flex-col gap-5 pb-8 lg:absolute lg:inset-y-0 lg:left-0 lg:w-[44%] lg:justify-center lg:pb-0 lg:pl-12" data-reveal>
        <h2 id="team-title" class="display text-[clamp(2rem,3.4vw,3rem)]">{TEAM_INTRO.title}</h2>
        <p class="max-w-[42ch] text-lg leading-relaxed text-ink-soft">{TEAM_INTRO.text}</p>
      </div>
      <div class="window overflow-hidden">
        <Image
          src={equipe}
          alt="Dylan, Théo et Margot, l’équipe des Drones Lyonnais, avec Pop, leur chien samoyède"
          widths={[640, 960, 1280, 1920]}
          sizes="(min-width: 1280px) 1168px, 92vw"
          class="team-photo aspect-[2125/762] w-full object-cover max-lg:aspect-[16/10] max-lg:object-[80%_50%]"
        />
      </div>
    </div>
  </div>

  <ul class="wrap mt-14 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
    {
      TEAM.map((member, i) => (
        <li class="member flex flex-col" data-reveal style={{ '--i': i }}>
          <Portrait file={member.portrait} class="mb-6 size-28 md:size-32" />
          <h3 class="text-xl font-bold [font-stretch:112%]">{member.name}</h3>
          <p class="mt-1 font-medium text-gold-deep">{member.role}</p>
          <p class="mt-3 leading-relaxed text-ink-soft">{member.bio}</p>
          <p class="mt-4 border-t border-line pt-3 text-sm leading-relaxed text-muted">{member.skills.join(', ')}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* The window clips (overflow: hidden makes it a scroll container), so the photo
     follows the window's named timeline rather than its own. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .window {
        view-timeline: --team-window block;
        animation-name: open-window;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --team-window;
        animation-range: entry 10% cover 45%;
      }
      .team-photo {
        animation-name: settle;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --team-window;
        animation-range: entry 10% cover 45%;
      }
    }
  }
  @keyframes open-window {
    from {
      clip-path: inset(12% 0 12% 46%);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes settle {
    from {
      transform: scale(1.15);
    }
  }
</style>

<script>
  // Portraits lean towards the pointer while it moves over their card.
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fine && !still) {
    document.querySelectorAll<HTMLElement>('.member').forEach((card) => {
      const portrait = card.querySelector<HTMLElement>('.portrait');
      if (!portrait) return;
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        portrait.style.setProperty('--mx', (((e.clientX - r.left) / r.width) * 2 - 1).toFixed(3));
        portrait.style.setProperty('--my', (((e.clientY - r.top) / r.height) * 2 - 1).toFixed(3));
      });
      card.addEventListener('pointerleave', () => {
        portrait.style.setProperty('--mx', '0');
        portrait.style.setProperty('--my', '0');
      });
    });
  }
</script>
