---
// The team, introduced one by one: on large
// screens the stage stays pinned while scrolling hands over from one member to the
// next — names on the left, the member's portrait and story on the right. The portrait
// leans towards the pointer. On small screens, the members are simply stacked.
import Portrait from '../ui/Portrait.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { TEAM, TEAM_INTRO } from '../../data/home';
---

<section aria-labelledby="team-title" class="team bg-paper">
  <div class="wrap pt-[clamp(80px,10vw,128px)]">
    <SectionHeader id="team-title" title={TEAM_INTRO.title}>
      <p class="max-w-[42ch]">{TEAM_INTRO.text}</p>
    </SectionHeader>
  </div>

  <div class="crew" style={{ '--count': TEAM.length }}>
    <div class="stage wrap">
      <ol class="names" aria-label="L’équipe">
        {
          TEAM.map((member, i) => (
            <li>
              <button type="button" class="name" data-index={i} aria-controls={`member-${i}`}>
                {member.name}
              </button>
            </li>
          ))
        }
      </ol>

      <div class="cards">
        {
          TEAM.map((member, i) => (
            <article class="card" id={`member-${i}`} data-card={i} data-active={i === 0 || undefined} data-reveal>
              <div class="card-avatar">
                <Portrait photo={member.photo} video={member.video} cutRadius={member.cutRadius} alt={`${member.name}, ${member.role.toLowerCase()}`} class="size-full" />
              </div>
              <div class="card-text">
                <h3 class="card-name">{member.name}</h3>
                <p class="card-role">{member.role}</p>
                <p class="card-bio">{member.bio}</p>
                <ul class="card-skills" aria-label="Spécialités">
                  {member.skills.map((skill) => (
                    <li>{skill}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Crew: stacked cards by default (small screens) ---------- */
  .crew {
    padding-block: 64px 96px;
  }
  .names {
    display: none;
  }
  .cards {
    display: grid;
    gap: 56px;
  }
  .card {
    display: grid;
    grid-template-columns: 112px 1fr;
    gap: 20px;
    align-items: start;
  }
  .card-avatar {
    width: 112px;
    height: 112px;
  }
  .card-name {
    font-size: 1.5rem;
    font-weight: 700;
    font-stretch: 118%;
    letter-spacing: -0.01em;
  }
  .card-role {
    margin-top: 4px;
    font-weight: 500;
    color: var(--color-gold-deep);
  }
  .card-bio {
    margin-top: 12px;
    max-width: 46ch;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
  .card-skills {
    font-stretch: 75%;
    letter-spacing: 0.05em;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--color-line);
    font-size: 14px;
    color: var(--color-muted);
  }
  .card-skills li::before {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 8px;
    vertical-align: middle;
    background: var(--color-gold);
  }

  /* ---------- Crew: pinned stage (large screens) ---------- */
  @media (min-width: 1024px) {
    .crew {
      height: calc(var(--count) * 85svh);
      padding: 0;
    }
    .stage {
      position: sticky;
      top: 0;
      height: 100svh;
      display: grid;
      grid-template-columns: 5fr 7fr;
      align-items: center;
      gap: 48px;
    }
    .names {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .name {
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.3em;
      padding: 0;
      font-size: clamp(3.4rem, 6.4vw, 6.4rem);
      font-weight: 800;
      font-stretch: 125%;
      letter-spacing: -0.03em;
      line-height: 1.02;
      color: transparent;
      -webkit-text-stroke: 1.5px rgb(0 0 0 / 0.22);
      cursor: pointer;
      transition:
        color 450ms var(--ease-out-strong),
        -webkit-text-stroke-color 450ms var(--ease-out-strong);
    }
    .name::before {
      content: '';
      width: 0.16em;
      height: 0.16em;
      background: var(--color-gold);
      transform: scale(0);
      transition: transform 400ms var(--ease-out-strong);
    }
    .name[aria-current='true'] {
      color: var(--color-ink);
      -webkit-text-stroke-color: var(--color-ink);
    }
    .name[aria-current='true']::before {
      transform: scale(1);
    }
    .name:focus-visible {
      outline-offset: 6px;
    }
    @media (hover: hover) and (pointer: fine) {
      .name:not([aria-current='true']):hover {
        -webkit-text-stroke-color: rgb(0 0 0 / 0.6);
      }
    }

    .cards {
      position: relative;
      display: block;
      height: min(72svh, 620px);
    }
    .card {
      position: absolute;
      inset: 0;
      grid-template-columns: 1fr;
      align-content: center;
      justify-items: start;
      gap: 28px;
      pointer-events: none;
    }
    .card[data-active] {
      pointer-events: auto;
    }
    .card-avatar {
      width: min(44svh, 380px);
      height: min(44svh, 380px);
    }
    .card-name {
      display: none;
    }
    .card-role {
      margin-top: 0;
      font-size: 1.25rem;
    }
    .card-bio {
      font-size: 1.125rem;
    }

    /* Hand-over between members: the portrait rises in, the words follow. */
    .card-avatar,
    .card-text > * {
      opacity: 0;
      transition:
        opacity 500ms var(--ease-out-strong),
        transform 700ms var(--ease-out-strong);
    }
    .card-avatar {
      transform: translateY(24px) scale(0.94);
    }
    .card-text > * {
      transform: translateY(18px);
    }
    .card[data-active] .card-avatar,
    .card[data-active] .card-text > * {
      opacity: 1;
      transform: none;
    }
    .card[data-active] .card-text > :nth-child(2) {
      transition-delay: 80ms;
    }
    .card[data-active] .card-text > :nth-child(3) {
      transition-delay: 140ms;
    }
    .card[data-active] .card-text > :nth-child(4) {
      transition-delay: 200ms;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-avatar,
    .card-text > * {
      transform: none !important;
      transition: opacity 250ms ease !important;
    }
  }
</style>

<script>
  // Pinned crew: the scroll position inside the crew picks the member; the names jump
  // there. The portrait in focus drifts slightly with the pointer.
  const crew = document.querySelector<HTMLElement>('.team .crew');
  if (crew) {
    const names = [...crew.querySelectorAll<HTMLButtonElement>('.name')];
    const cards = [...crew.querySelectorAll<HTMLElement>('.card')];
    const wide = matchMedia('(min-width: 1024px)');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = -1;

    const activate = (i: number) => {
      if (i === current) return;
      current = i;
      cards.forEach((c, k) => c.toggleAttribute('data-active', k === i));
      names.forEach((n, k) => n.setAttribute('aria-current', String(k === i)));
    };

    const progress = () => {
      const r = crew.getBoundingClientRect();
      const span = r.height - innerHeight;
      return span > 0 ? Math.min(0.999, Math.max(0, -r.top / span)) : 0;
    };
    const onScroll = () => {
      if (wide.matches) activate(Math.floor(progress() * cards.length));
    };
    addEventListener('scroll', onScroll, { passive: true });
    activate(0);
    onScroll();

    names.forEach((name, i) => {
      name.addEventListener('click', () => {
        const r = crew.getBoundingClientRect();
        const span = r.height - innerHeight;
        const top = scrollY + r.top + ((i + 0.5) / cards.length) * span;
        scrollTo({ top, behavior: still ? 'auto' : 'smooth' });
      });
    });

    if (!still && matchMedia('(hover: hover) and (pointer: fine)').matches) {
      addEventListener(
        'pointermove',
        (e) => {
          const avatar = cards[current]?.querySelector<HTMLElement>('.portrait');
          if (!avatar) return;
          const r = avatar.getBoundingClientRect();
          if (r.bottom < 0 || r.top > innerHeight) return;
          const dx = (e.clientX - (r.left + r.width / 2)) / innerWidth;
          const dy = (e.clientY - (r.top + r.height / 2)) / innerHeight;
          const clamp = (v: number) => Math.max(-1, Math.min(1, v * 2.5));
          avatar.style.setProperty('--px', clamp(dx).toFixed(3));
          avatar.style.setProperty('--py', clamp(dy).toFixed(3));
        },
        { passive: true },
      );
    }
  }
</script>
