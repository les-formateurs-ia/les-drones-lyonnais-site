---
import Button from '../ui/Button.astro';
import Activities from './Activities.astro';
import { HERO, FACTS } from '../../data/home';
import { SITE } from '../../data/site';
---

<section aria-labelledby="hero-title">
  <div class="wrap grid gap-8 pt-10 pb-10 md:pt-14 lg:grid-cols-12 lg:gap-10 lg:pt-14 lg:pb-12">
    <h1 id="hero-title" class="display text-[clamp(2.3rem,4.7vw,4.25rem)] lg:col-span-8">
      {HERO.title}
    </h1>

    <div class="flex flex-col gap-7 lg:col-span-4 lg:self-end">
      <p class="max-w-[42ch] text-lg leading-relaxed text-ink-soft">{HERO.intro}</p>
      <div class="flex flex-wrap gap-3">
        <Button href={SITE.contactPath}>Demander un devis</Button>
        <Button href={SITE.phoneHref} variant="outline">{SITE.phone}</Button>
      </div>
      <dl class="flex gap-10 border-t border-line pt-5">
        {
          FACTS.map((fact) => (
            <div class="flex flex-col-reverse">
              <dt class="text-sm text-muted">{fact.label}</dt>
              <dd class="text-2xl font-bold [font-stretch:125%]">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <Activities />
</section>
