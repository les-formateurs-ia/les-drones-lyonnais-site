---
// The photo drifts inside its frame (parallax) and the gold rules draw themselves
// as each commitment arrives.
import { Image } from 'astro:assets';
import france from '../../assets/images/partout-en-france.jpg';
import { COMMITMENTS } from '../../data/home';
---

<section aria-labelledby="commitments-title" class="bg-mist py-20 md:py-32">
  <div class="wrap grid gap-12 md:grid-cols-12 md:gap-10">
    <div class="frame relative overflow-hidden md:col-span-5 aspect-[4/5] max-md:aspect-[4/3]">
      <Image
        src={france}
        alt="La voiture des Drones Lyonnais garée devant un château, en déplacement pour une mission"
        widths={[480, 720, 960]}
        sizes="(min-width: 768px) 40vw, 92vw"
        class="drift absolute inset-x-0 -top-[8%] h-[116%] w-full object-cover max-md:object-[50%_60%]"
      />
    </div>

    <div class="flex flex-col justify-center md:col-span-7 lg:pl-8">
      <div data-reveal>
        <h2 id="commitments-title" class="display text-[clamp(2rem,3.6vw,3.2rem)]">Basés à Lyon, au plus près de vos projets</h2>
        <p class="mt-5 max-w-[52ch] text-lg leading-relaxed text-ink-soft">
          Nous nous déplaçons dans toute la France avec notre matériel professionnel. Notre connaissance des réglementations locales rend chaque tournage et chaque inspection fluides.
        </p>
      </div>

      <ul class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2">
        {
          COMMITMENTS.map((item, i) => (
            <li class="commitment pt-5" data-reveal style={{ '--i': i }}>
              <h3 class="text-lg font-bold [font-stretch:112%]">{item.title}</h3>
              <p class="mt-2 leading-relaxed text-ink-soft">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .commitment {
    position: relative;
  }
  .commitment::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: var(--color-gold);
    transform-origin: left;
  }
  /* The rule draws once the item is revealed. */
  :global(.js) .commitment::before {
    transform: scaleX(0);
    transition: transform 900ms var(--ease-out-strong);
    transition-delay: calc(200ms + var(--i, 0) * 90ms);
  }
  :global(.js) .commitment:global(.is-in)::before {
    transform: scaleX(1);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* The frame clips, so the photo follows the frame's timeline, not its own. */
      .frame {
        view-timeline: --frame block;
      }
      .drift {
        animation-name: drift-y;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --frame;
      }
    }
  }
  @keyframes drift-y {
    from {
      transform: translateY(-6%);
    }
    to {
      transform: translateY(6%);
    }
  }
</style>
