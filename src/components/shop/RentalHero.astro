---
// /location-drone-et-camera/ opening, after the current page: search field over a dark
// band, the rental categories as large visual tiles (each filters the catalogue below),
// then the ready-to-shoot packs with what they contain and their daily price.
import Square from '../ui/Square.astro';
import SearchBox from './SearchBox.astro';
import PopTip from '../ui/PopTip.astro';
import { RENTAL_FILTERS, forRent, formatPrice, productUrl } from '../../data/catalog';
import { productPhoto } from '../../lib/product-photo';
import { pick } from '../../lib/pick';
import { ACTIVITIES } from '../../data/site';

const categories = await Promise.all(
  RENTAL_FILTERS.map(async (f) => {
    const items = forRent.filter(f.match);
    return { ...f, count: items.length, photo: items.length ? await productPhoto(items[0], 1) : null };
  }),
);

// Packs with their content list (from the product description), best known first.
const packs = await Promise.all(
  pick('pack-drone-plus-camera-location', 'pack-inspection-thermqiue-par-drone-location', 'location-pack-interview', 'smallrig-rc120d-eclairage-led-cob-120w-pack-duo').map(
    async (p) => ({ p, photo: await productPhoto(p, 4 / 3), content: p.description.filter((b) => b.type === 'li').map((b) => b.text) }),
  ),
);
---

<section class="rent-hero" aria-labelledby="rent-title">
  <div class="top">
    <div class="wrap">
      <nav aria-label="Fil d’Ariane" class="hud-text crumbs">
        <a href="/">Accueil</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Location</span>
      </nav>
      <div class="head">
        <h1 id="rent-title" class="display flex items-start gap-4 text-[clamp(2rem,3.6vw,3.3rem)]">
          <Square color={ACTIVITIES.location.color} class="mt-[0.2em] size-[0.3em] shrink-0" />
          Location drone et matériel audiovisuel
        </h1>
        <p class="lead">Le matériel de nos tournages, vérifié et prêt à partir. Prix à la journée, TTC et HT.</p>
      </div>
      <SearchBox types={['location']} placeholder="Mavic 4 Pro, Sony A7S III, micro, éclairage…" action="/location-drone-et-camera/" />
    </div>
  </div>

  <div class="wrap cats-wrap">
    <ul class="cats" aria-label="Catégories de location">
      {
        categories.map((c, i) => (
          <li style={{ '--k': i }}>
            <a class="cat" href={`/location-drone-et-camera/?filtre=${c.id}#catalogue`} data-goto-filter={c.id}>
              <span class="cat-img">{c.photo && <img src={c.photo.src} srcset={c.photo.srcset} sizes="160px" alt="" loading="lazy" decoding="async" />}</span>
              <span class="cat-name">{c.label}</span>
              <span class="cat-count hud-text">{c.count} références</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section id="packs" class="packs section-pad scroll-mt-16 bg-paper" aria-labelledby="packs-title">
  <div class="wrap">
    <div class="packs-head">
      <div data-reveal>
        <h2 id="packs-title" class="display flex items-start gap-4 text-[clamp(2.1rem,4vw,3.4rem)]">
          <Square color={ACTIVITIES.location.color} class="mt-[0.55em] size-3.5 shrink-0 md:size-4" />
          Packs prêts à tourner
        </h2>
        <p class="mt-4 max-w-[44ch] text-lg leading-relaxed text-ink-soft">Des solutions complètes, testées ensemble, en une seule réservation.</p>
      </div>
      <PopTip pose="pilote" title="Un tournage, un pack" action={{ label: 'Demander à Pop', chat: 'Quel pack choisir ?' }} class="packs-pop">
        Dites-moi ce que vous filmez, je vous indique le pack adapté.
      </PopTip>
    </div>

    <ul class="pack-list">
      {
        packs.map(({ p, photo, content }, i) => (
          <li data-reveal style={{ '--i': i % 2 }}>
            <a class="pack" href={productUrl(p)}>
              <span class="pack-img">{photo && <img src={photo.src} srcset={photo.srcset} sizes="(min-width: 1024px) 300px, 92vw" alt="" loading="lazy" decoding="async" />}</span>
              <span class="pack-body">
                <span class="pack-name">{p.name}</span>
                {content.length > 0 && (
                  <span class="pack-content">
                    {content.slice(0, 6).map((c) => (
                      <span>{c}</span>
                    ))}
                    {content.length > 6 && <span class="more">et {content.length - 6} autres éléments</span>}
                  </span>
                )}
                <span class="pack-price">
                  <strong>{formatPrice(p.priceTTC)} TTC</strong> / jour <span class="ht">{formatPrice(p.priceHT)} HT</span>
                </span>
                <span class="pack-cue">Voir le pack</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .rent-hero {
    background: var(--color-paper);
  }
  .top {
    padding: 104px 0 120px;
    background:
      radial-gradient(ellipse at 85% 0%, rgb(226 93 2 / 0.25), transparent 55%),
      var(--color-ink);
    color: #fff;
  }
  .crumbs {
    display: flex;
    gap: 10px;
    color: rgb(255 255 255 / 0.6);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 40px;
    margin: 14px 0 28px;
  }
  .lead {
    max-width: 40ch;
    color: rgb(255 255 255 / 0.75);
  }

  /* Category tiles overlap the dark band. */
  .cats-wrap {
    margin-top: -88px;
  }
  .cats {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
  }
  .cats li {
    animation: tile-in 600ms var(--ease-out-strong) backwards;
    animation-delay: calc(200ms + var(--k) * 60ms);
  }
  @keyframes tile-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  .cat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    height: 100%;
    padding: 14px 12px 16px;
    border: 1px solid var(--color-line);
    background: #fff;
    text-align: center;
    box-shadow: 0 20px 40px -30px rgb(0 0 0 / 0.5);
    transition:
      border-color 200ms ease,
      transform 300ms var(--ease-out-strong);
  }
  .cat-img {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    margin-bottom: 6px;
    overflow: hidden;
  }
  .cat-img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 500ms var(--ease-out-strong);
  }
  .cat-name {
    font-weight: 700;
    font-stretch: 112%;
  }
  .cat-count {
    color: var(--color-location);
  }
  @media (hover: hover) and (pointer: fine) {
    .cat:hover {
      border-color: var(--color-location);
      transform: translateY(-4px);
    }
    .cat:hover .cat-img img {
      transform: scale(1.08);
    }
  }

  /* ---------- Packs ---------- */
  .packs-head {
    display: grid;
    gap: 24px;
    align-items: end;
  }
  @media (min-width: 1024px) {
    .packs-head {
      grid-template-columns: 7fr 5fr;
    }
  }
  .pack-list {
    display: grid;
    gap: 20px;
    margin-top: 48px;
  }
  @media (min-width: 900px) {
    .pack-list {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pack {
    display: grid;
    grid-template-columns: 2fr 3fr;
    height: 100%;
    border: 1px solid var(--color-line);
    background: #fff;
    transition: border-color 200ms ease;
  }
  .pack-img {
    display: block;
    border-right: 1px solid var(--color-line);
  }
  .pack-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 600ms var(--ease-out-strong);
  }
  .pack-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px;
  }
  .pack-name {
    font-size: 1.25rem;
    font-weight: 700;
    font-stretch: 112%;
    line-height: 1.2;
  }
  .pack-content {
    display: grid;
    gap: 4px;
    font-size: 14px;
    color: var(--color-ink-soft);
  }
  .pack-content span::before {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 8px;
    vertical-align: middle;
    background: var(--color-location);
  }
  .pack-content .more::before {
    background: var(--color-line);
  }
  .pack-price {
    margin-top: auto;
    padding-top: 8px;
  }
  .pack-price strong {
    font-size: 1.3rem;
    font-weight: 800;
    font-stretch: 118%;
  }
  .ht {
    display: block;
    font-size: 13px;
    color: var(--color-muted);
  }
  .pack-cue {
    width: fit-content;
    font-weight: 700;
    color: var(--color-location);
    background: linear-gradient(currentColor, currentColor) no-repeat left bottom / 0 1.5px;
    transition: background-size 300ms var(--ease-out-strong);
  }
  @media (hover: hover) and (pointer: fine) {
    .pack:hover {
      border-color: var(--color-location);
    }
    .pack:hover .pack-img img {
      transform: scale(1.05);
    }
    .pack:hover .pack-cue {
      background-size: 100% 1.5px;
    }
  }

  @media (max-width: 1023px) {
    .cats {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 560px) {
    .cats {
      grid-template-columns: repeat(2, 1fr);
    }
    .pack {
      grid-template-columns: 1fr;
    }
    .pack-img {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
      aspect-ratio: 4 / 3;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cats li {
      animation: none;
    }
    .cat,
    .cat-img img,
    .pack-img img {
      transition: none;
    }
  }
</style>
