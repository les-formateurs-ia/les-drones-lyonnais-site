---
// Big search field with live results (thumbnail, name, price) under it. Enter or "voir
// tous les résultats" filters the catalogue of the page (?q=…#catalogue). Without
// JavaScript it is a plain GET form to the same page.
import popLoupe from '../../assets/pop/loupe.webp';
import { Image } from 'astro:assets';

interface Props {
  /** Index types to search: 'vente', 'location'. */
  types: string[];
  placeholder: string;
  /** Page whose catalogue receives the query. */
  action: string;
  dark?: boolean;
}
const { types, placeholder, action, dark = false } = Astro.props;
---

<form class:list={['search', dark && 'search-dark']} action={`${action}#catalogue`} method="get" role="search" data-search data-types={types.join(' ')}>
  <label class="field">
    <span class="sr-only">Rechercher</span>
    <svg viewBox="0 0 20 20" aria-hidden="true" class="icon"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
    <input
      type="search"
      name="q"
      placeholder={placeholder}
      autocomplete="off"
      role="combobox"
      aria-expanded="false"
      aria-autocomplete="list"
      aria-controls="search-results"
    />
    <Image src={popLoupe} alt="" width={64} densities={[1, 2]} class="pop" />
  </label>
  <div class="results" id="search-results" role="listbox" hidden></div>
</form>

<style>
  .search {
    position: relative;
    width: 100%;
    max-width: 720px;
  }
  .field {
    position: relative;
    display: flex;
    align-items: center;
  }
  .icon {
    position: absolute;
    left: 20px;
    width: 20px;
    height: 20px;
    color: var(--color-muted);
    pointer-events: none;
  }
  input {
    width: 100%;
    min-height: 62px;
    padding: 0 84px 0 54px;
    border: 1px solid var(--color-line);
    background: #fff;
    color: var(--color-ink);
    font: inherit;
    font-size: 17px;
    box-shadow: 0 20px 40px -24px rgb(0 0 0 / 0.5);
  }
  input:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 0;
  }
  /* Pop peeks over the right end of the field, magnifying glass in paw. */
  .pop {
    position: absolute;
    right: 12px;
    bottom: 6px;
    width: 56px;
    height: auto;
    pointer-events: none;
    transform-origin: 50% 100%;
    transition: transform 400ms var(--ease-out-strong);
  }
  .search:focus-within .pop {
    transform: translateY(-6px) rotate(-6deg) scale(1.08);
  }
  .results {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    z-index: 40;
    max-height: min(60vh, 460px);
    overflow-y: auto;
    border: 1px solid var(--color-line);
    background: #fff;
    color: var(--color-ink);
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.45);
    animation: drop 220ms var(--ease-out-strong);
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .results :global(a) {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-line);
  }
  .results :global(a[aria-selected='true']),
  .results :global(a:hover) {
    background: var(--color-mist);
  }
  .results :global(img) {
    width: 48px;
    height: 48px;
    object-fit: contain;
    background: #fff;
  }
  .results :global(.n) {
    font-weight: 600;
    line-height: 1.3;
  }
  .results :global(.d) {
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }
  .results :global(.all) {
    display: block;
    padding: 12px 14px;
    font-weight: 700;
    color: var(--color-gold-deep);
  }
  .results :global(.empty) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px;
    color: var(--color-ink-soft);
  }
  @media (prefers-reduced-motion: reduce) {
    .pop {
      transition: none;
    }
    .results {
      animation: none;
    }
  }
</style>

<script>
  import { search } from '../../lib/search-client';

  document.querySelectorAll<HTMLFormElement>('[data-search]').forEach((form) => {
    const input = form.querySelector('input')!;
    const box = form.querySelector<HTMLElement>('.results')!;
    const types = form.dataset.types!.split(' ');
    let active = -1;
    let seq = 0;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

    const close = () => {
      box.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      active = -1;
    };
    const render = async () => {
      const q = input.value.trim();
      const mine = ++seq;
      if (q.length < 2) return close();
      const results = await search(q, types, 7);
      if (mine !== seq) return;
      const all = `${form.getAttribute('action')!.split('#')[0]}?q=${encodeURIComponent(q)}#catalogue`;
      box.innerHTML = results.length
        ? results
            .map(
              (r, i) =>
                `<a href="${r.u}" role="option" id="sr-${i}" aria-selected="false">${r.i ? `<img src="${r.i}" alt="" width="48" height="48">` : '<span></span>'}<span class="n">${esc(r.n)}</span><span class="d">${esc(r.d ?? '')}</span></a>`,
            )
            .join('') + `<a class="all" href="${all}">Voir tous les résultats pour « ${esc(q)} »</a>`
        : `<p class="empty">Pop n’a rien trouvé pour « ${esc(q)} ». Essayez un modèle (Mini, Mavic, Matrice…) ou demandez-lui dans le chat.</p>`;
      box.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      active = -1;
    };
    input.addEventListener('input', render);
    input.addEventListener('focus', () => input.value.trim().length >= 2 && render());
    input.addEventListener('keydown', (e) => {
      const options = [...box.querySelectorAll<HTMLAnchorElement>('a[role=option]')];
      if (e.key === 'Escape') return close();
      if (!options.length || (e.key !== 'ArrowDown' && e.key !== 'ArrowUp')) return;
      e.preventDefault();
      active = (active + (e.key === 'ArrowDown' ? 1 : -1) + options.length) % options.length;
      options.forEach((o, i) => o.setAttribute('aria-selected', String(i === active)));
      input.setAttribute('aria-activedescendant', options[active].id);
    });
    form.addEventListener('submit', (e) => {
      const options = [...box.querySelectorAll<HTMLAnchorElement>('a[role=option]')];
      if (active >= 0 && options[active]) {
        e.preventDefault();
        location.href = options[active].href;
      }
    });
    document.addEventListener('click', (e) => {
      if (!form.contains(e.target as Node)) close();
    });
  });
</script>
