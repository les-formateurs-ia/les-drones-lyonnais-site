---
// Product pages: Pop's advice on this product, as one strong moment instead of small
// bubbles scattered in the page (client request, 2026-10-28). Pop, large, on a gold
// disc; his advice arrives as chat messages (typing dots, then the message, Pop hops),
// then quick questions that open his chat already asked. Without JavaScript or with
// reduced motion, everything is simply shown.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  messages: string[];
  /** Questions known by PopChat. */
  chips: string[];
  pose: ImageMetadata;
  /** Short product name, in the heading. */
  product: string;
}
const { title, messages, chips, pose, product } = Astro.props;
---

<section class="advice section-pad" aria-labelledby="advice-title" data-advice>
  <div class="wrap grid">
    <figure class="stage">
      <span class="sun" aria-hidden="true"></span>
      <span class="paw p1" aria-hidden="true"></span>
      <span class="paw p2" aria-hidden="true"></span>
      <Image src={pose} alt="Pop, le samoyède de l’équipe et mascotte des Drones Lyonnais" widths={[320, 480, 640]} sizes="(min-width: 1024px) 380px, 240px" class="pop" data-pop-img />
      <span class="floor" aria-hidden="true"></span>
      <figcaption class="tag hud-text"><span class="live"></span>Pop · conseiller en ligne</figcaption>
    </figure>

    <div class="chat">
      <p class="kicker hud-text">L’avis de Pop</p>
      <h2 id="advice-title" class="display">
        {title}
        <span class="about">sur le {product}</span>
      </h2>

      <ol class="msgs" aria-live="polite">
        {
          messages.map((m) => (
            <li class="msg" data-msg>
              <p>
                <span class="text">{m}</span>
                <span class="dots" aria-hidden="true">
                  <span />
                  <span />
                  <span />
                </span>
              </p>
            </li>
          ))
        }
      </ol>

      <div class="ask" data-chips>
        <p class="ask-label">Une autre question ? Pop répond tout de suite.</p>
        <ul class="chips">
          {
            chips.map((q, i) => (
              <li style={{ '--k': i }}>
                <button type="button" class="chip" data-pop-open data-pop-ask={q}>
                  {q}
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .advice {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 40% 60% at 18% 60%, rgb(175 133 74 / 0.16), transparent 70%),
      #f6f1e8;
  }
  .grid {
    display: grid;
    gap: 32px 72px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: 5fr 7fr;
    }
  }

  /* ---------- Pop ---------- */
  .stage {
    position: relative;
    display: grid;
    justify-items: center;
    margin: 0;
    padding-top: 24px;
  }
  .sun {
    position: absolute;
    top: 8%;
    left: 50%;
    width: min(88%, 400px);
    aspect-ratio: 1;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #d9b47a, var(--color-gold) 60%, #9a7038);
    box-shadow: 0 30px 60px -30px rgb(120 80 30 / 0.6);
  }
  /* Two paw prints, for fun. */
  .paw {
    position: absolute;
    width: 34px;
    aspect-ratio: 1;
    opacity: 0.25;
    background: radial-gradient(circle at 50% 70%, var(--color-gold-deep) 30%, transparent 32%), radial-gradient(circle at 20% 30%, var(--color-gold-deep) 12%, transparent 14%), radial-gradient(circle at 50% 18%, var(--color-gold-deep) 12%, transparent 14%), radial-gradient(circle at 80% 30%, var(--color-gold-deep) 12%, transparent 14%);
  }
  .p1 {
    top: 6%;
    left: 4%;
    rotate: -20deg;
  }
  .p2 {
    bottom: 22%;
    right: 2%;
    rotate: 25deg;
  }
  .stage :global(.pop) {
    position: relative;
    width: min(80%, 360px);
    height: auto;
    filter: drop-shadow(0 18px 24px rgb(80 60 30 / 0.25));
    transform-origin: 50% 100%;
  }
  .floor,
  .tag {
    position: relative;
  }
  .floor {
    width: 60%;
    height: 22px;
    margin-top: -14px;
    border-radius: 50%;
    background: radial-gradient(rgb(90 60 20 / 0.35), transparent 70%);
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    padding: 7px 12px;
    color: #fff;
    background: var(--color-ink);
  }
  .live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3ecf6a;
    box-shadow: 0 0 0 3px rgb(62 207 106 / 0.25);
  }

  /* ---------- Chat ---------- */
  .kicker {
    text-transform: uppercase;
    color: var(--color-gold-deep);
  }
  h2 {
    margin-top: 10px;
    font-size: clamp(2rem, 3.6vw, 3rem);
  }
  .about {
    display: block;
    margin-top: 6px;
    font-size: 0.5em;
    font-stretch: 100%;
    letter-spacing: 0;
    color: var(--color-ink-soft);
  }
  .msgs {
    display: grid;
    gap: 12px;
    margin-top: 28px;
  }
  .msg p {
    position: relative;
    max-width: 62ch;
    padding: 18px 22px;
    font-size: 1.08rem;
    line-height: 1.6;
    background: #fff;
    border-radius: 4px 20px 20px 20px;
    box-shadow: 0 18px 36px -24px rgb(60 40 10 / 0.35);
  }
  .msg:first-child p::before {
    content: '';
    position: absolute;
    top: 0;
    left: -10px;
    border-top: 12px solid #fff;
    border-left: 10px solid transparent;
  }
  /* "Pop is writing…": shown in the bubble before its text. */
  .dots {
    position: absolute;
    top: 22px;
    left: 22px;
    display: flex;
    gap: 5px;
    opacity: 0;
  }
  .dots span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-gold);
    animation: dot 900ms ease-in-out infinite;
  }
  .dots span:nth-child(2) {
    animation-delay: 150ms;
  }
  .dots span:nth-child(3) {
    animation-delay: 300ms;
  }
  @keyframes dot {
    50% {
      transform: translateY(-4px);
      opacity: 0.5;
    }
  }
  .ask {
    margin-top: 28px;
  }
  .ask-label {
    font-weight: 600;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
  .chip {
    padding: 10px 16px;
    font-weight: 600;
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      transform 160ms ease-out;
  }
  @media (hover: hover) and (pointer: fine) {
    .chip:hover {
      color: #fff;
      background: var(--color-ink);
    }
  }
  .chip:active {
    transform: scale(0.97);
  }
  .chip:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 3px;
  }

  /* ---------- The conversation plays once on screen ----------
     Every bubble keeps its place (no layout shift): hidden → typing (bubble, dots) →
     on (text). */
  @media (prefers-reduced-motion: no-preference) {
    .msg,
    .ask {
      transform-origin: 0 0;
      transition:
        opacity 400ms ease,
        transform 600ms cubic-bezier(0.34, 1.4, 0.64, 1);
    }
    .text {
      transition: opacity 400ms ease;
    }
    :global(.js) .advice:not(.is-done) .msg:not(.is-typing, .is-on),
    :global(.js) .advice:not(.is-done) .ask:not(.is-on) {
      opacity: 0;
      transform: translateY(14px) scale(0.96);
    }
    :global(.js) .advice:not(.is-done) .msg:not(.is-on) .text {
      opacity: 0;
    }
    .msg.is-typing .dots {
      opacity: 1;
    }
    .stage :global(.pop) {
      animation: breathe 4s ease-in-out infinite;
    }
    .stage :global(.pop.hop) {
      animation: hop 520ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .sun {
      animation: sun 14s ease-in-out infinite alternate;
    }
    .live {
      animation: live 2s ease-out infinite;
    }
  }
  @keyframes hop {
    30% {
      transform: translateY(-14px) scaleY(1.03);
    }
    60% {
      transform: translateY(0) scaleY(0.97);
    }
  }
  @keyframes breathe {
    50% {
      transform: scaleY(1.012);
    }
  }
  @keyframes sun {
    to {
      scale: 1.05;
      translate: -50% 6px;
    }
  }
  @keyframes live {
    70% {
      box-shadow: 0 0 0 7px rgb(62 207 106 / 0);
    }
  }
</style>

<script>
  // Plays the conversation once, when the section comes into view.
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-advice]').forEach((box) => {
    if (still) return box.classList.add('is-done');
    const msgs = [...box.querySelectorAll<HTMLElement>('[data-msg]')];
    const ask = box.querySelector<HTMLElement>('[data-chips]')!;
    const pop = box.querySelector<HTMLElement>('[data-pop-img]');
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const hop = () => {
      if (!pop) return;
      pop.classList.remove('hop');
      void pop.offsetWidth;
      pop.classList.add('hop');
    };
    const play = async () => {
      for (const m of msgs) {
        m.classList.add('is-typing');
        // A longer message takes Pop a little longer to "write".
        await wait(Math.min(1500, 600 + (m.textContent?.length ?? 0) * 3));
        m.classList.replace('is-typing', 'is-on');
        hop();
        await wait(450);
      }
      ask.classList.add('is-on');
      await wait(700);
      box.classList.add('is-done');
    };
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          play();
        }
      },
      { threshold: 0.35 },
    );
    io.observe(box);
  });
</script>
