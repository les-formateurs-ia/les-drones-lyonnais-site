---
// The catalogue of a page (shop or rental): filter chips and a grid of products.
// Filtering runs in the browser (show/hide); without JavaScript, everything is listed.
// The active filter is kept in the URL (?filtre=…) so it can be shared and linked to.
import SectionHeader from '../ui/SectionHeader.astro';
import ProductCard from './ProductCard.astro';
import type { Filter, Product } from '../../data/catalog';

interface Props {
  id: string;
  title: string;
  intro: string;
  color: string;
  products: Product[];
  filters: Filter[];
}
const { id, title, intro, color, products, filters } = Astro.props;
const usedFilters = filters.filter((f) => products.some(f.match));
---

<section id={id} aria-labelledby={`${id}-title`} class="catalog section-pad scroll-mt-16 bg-paper" data-catalog>
  <div class="wrap">
    <SectionHeader id={`${id}-title`} title={title} color={color}>
      <p class="max-w-[44ch]">{intro}</p>
    </SectionHeader>

    <div class="chips mt-10" role="group" aria-label="Filtrer le catalogue">
      <button type="button" data-filter="tout" aria-pressed="true">Tout <span>{products.length}</span></button>
      {
        usedFilters.map((f) => (
          <button type="button" data-filter={f.id} aria-pressed="false">
            {f.label} <span>{products.filter(f.match).length}</span>
          </button>
        ))
      }
    </div>

    <ul class="grid mt-10 grid-cols-2 gap-x-5 gap-y-10 md:grid-cols-3 lg:grid-cols-4" aria-live="polite">
      {
        products.map((p) => (
          <li data-tags={usedFilters.filter((f) => f.match(p)).map((f) => f.id).join(' ')}>
            <ProductCard product={p} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 16px;
    border: 1px solid var(--color-line);
    font-size: 15px;
    font-weight: 600;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
  }
  .chips button span {
    font-size: 12px;
    font-stretch: 75%;
    color: var(--color-muted);
  }
  .chips button[aria-pressed='true'] {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: #fff;
  }
  .chips button[aria-pressed='true'] span {
    color: rgb(255 255 255 / 0.65);
  }
  @media (hover: hover) and (pointer: fine) {
    .chips button[aria-pressed='false']:hover {
      border-color: var(--color-ink);
    }
  }
  .chips button:active {
    transform: scale(0.97);
  }
  .grid li {
    animation: in 450ms var(--ease-out-strong) backwards;
  }
  .grid li[hidden] {
    display: none;
  }
  @keyframes in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .grid li {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-catalog]').forEach((catalog) => {
    const buttons = [...catalog.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...catalog.querySelectorAll<HTMLElement>('li[data-tags]')];
    const apply = (id: string, updateUrl: boolean) => {
      if (!buttons.some((b) => b.dataset.filter === id)) id = 'tout';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === id)));
      let n = 0;
      items.forEach((li) => {
        const show = id === 'tout' || li.dataset.tags!.split(' ').includes(id);
        li.hidden = !show;
        // Replay the entrance, staggered, for the items that stay.
        if (show) {
          li.style.animation = 'none';
          void li.offsetWidth;
          li.style.animation = '';
          li.style.animationDelay = `${Math.min(n++, 12) * 30}ms`;
        }
      });
      if (updateUrl) {
        const url = new URL(location.href);
        if (id === 'tout') url.searchParams.delete('filtre');
        else url.searchParams.set('filtre', id);
        history.replaceState(null, '', url);
      }
    };
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!, true)));
    const initial = new URL(location.href).searchParams.get('filtre');
    if (initial) apply(initial, false);
  });
</script>
