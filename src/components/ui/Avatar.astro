---
// Illustrated team avatars, drawn for the site in the brand palette (ink, gold, cream).
// Each one keeps what makes the person recognisable — hair, beard, necklace — without
// copying the photo. Parts are grouped so the page can animate them: the eyes blink and
// follow the pointer (--ex/--ey), the head leans (--hx), Pop wags his tongue.
export type AvatarId = 'dylan' | 'theo' | 'margot' | 'pop';

interface Props {
  who: AvatarId;
  class?: string;
}
const { who, class: className } = Astro.props;

const SKIN = '#f2dcc4';
const SKIN_SHADE = '#e3c3a0';
const INK = '#111';
const TEE = '#fbf8f3';
const TEE_SHADE = '#e9e1d4';
const GOLD = '#af854a';
const clip = `clip-${who}`;
---

<svg viewBox="0 0 200 200" class:list={['avatar', `avatar-${who}`, className]} aria-hidden="true" focusable="false">
  <defs>
    <clipPath id={clip}><circle cx="100" cy="100" r="96"></circle></clipPath>
  </defs>
  <circle class="disc" cx="100" cy="100" r="96" fill={INK}></circle>
  <g clip-path={`url(#${clip})`}>
    <g transform="translate(100 118) scale(1.16) translate(-100 -118)">
    {
      who === 'pop' ? (
        <g class="body">
          {/* Fluffy chest and harness */}
          <path d="M34 210 C30 170 52 146 100 144 C148 146 170 170 166 210 Z" fill={TEE} />
          <path d="M58 176 L72 168 L84 176 L100 170 L116 176 L128 168 L142 176" fill="none" stroke={TEE_SHADE} stroke-width="3" stroke-linecap="round" />
          <path d="M62 160 C80 176 120 176 138 160 L144 176 C122 194 78 194 56 176 Z" fill={INK} />
          <rect x="92" y="176" width="16" height="12" rx="2" fill={GOLD} />
          <g class="head">
            {/* Ears */}
            <path class="ear ear-l" d="M58 72 L66 26 L92 58 Z" fill={TEE} />
            <path class="ear ear-r" d="M142 72 L134 26 L108 58 Z" fill={TEE} />
            <path d="M66 62 L69 38 L84 56 Z" fill={SKIN_SHADE} />
            <path d="M134 62 L131 38 L116 56 Z" fill={SKIN_SHADE} />
            {/* Fluffy head */}
            <path
              d="M100 44 C112 38 126 46 132 52 C142 50 150 62 148 72 C158 78 160 92 154 100 C162 110 156 124 146 128 C148 140 136 150 126 150 C118 160 106 160 100 156 C94 160 82 160 74 150 C64 150 52 140 54 128 C44 124 38 110 46 100 C40 92 42 78 52 72 C50 62 58 50 68 52 C74 46 88 38 100 44 Z"
              fill={TEE}
            />
            <path d="M70 120 C80 140 120 140 130 120 C126 134 114 144 100 144 C86 144 74 134 70 120 Z" fill={TEE_SHADE} />
            {/* Eyes */}
            <g class="eyes">
              <g class="eye"><ellipse cx="82" cy="96" rx="5" ry="5.5" fill={INK} /><circle class="glint" cx="83.6" cy="94.2" r="1.4" fill="#fff" /></g>
              <g class="eye"><ellipse cx="118" cy="96" rx="5" ry="5.5" fill={INK} /><circle class="glint" cx="119.6" cy="94.2" r="1.4" fill="#fff" /></g>
            </g>
            {/* Muzzle, nose, mouth, tongue */}
            <ellipse cx="100" cy="118" rx="20" ry="15" fill="#fff" />
            <path d="M92 108 C92 104 108 104 108 108 C108 113 103 116 100 116 C97 116 92 113 92 108 Z" fill={INK} />
            <path d="M100 116 L100 121 M88 120 C92 127 100 125 100 121 C100 125 108 127 112 120" fill="none" stroke={INK} stroke-width="2.4" stroke-linecap="round" />
            <path class="tongue" d="M93 124 C93 140 107 140 107 124 Z" fill="#e8909a" />
            <path d="M100 126 L100 134" stroke="#c96f7b" stroke-width="1.6" stroke-linecap="round" />
          </g>
        </g>
      ) : (
        <g class="body">
          {/* Back hair (Margot's long hair sits behind the shoulders) */}
          {who === 'margot' && <path d="M58 86 C54 52 76 34 100 34 C124 34 146 52 142 86 L148 168 C130 176 70 176 52 168 Z" fill="#8a5636" />}
          {/* T-shirt */}
          <path d="M28 210 C28 172 52 154 82 150 L118 150 C148 154 172 172 172 210 Z" fill={TEE} />
          <path d="M82 150 C88 164 112 164 118 150" fill="none" stroke={TEE_SHADE} stroke-width="4" />
          <text x="116" y="177" font-size="10" font-weight="800" font-family="Archivo, sans-serif" fill={INK} letter-spacing="0.5">LDL</text>
          {/* Neck */}
          <path d="M88 126 L112 126 L114 152 C106 158 94 158 86 152 Z" fill={SKIN_SHADE} />
          {/* Necklaces */}
          {who === 'dylan' && (
            <g>
              <path d="M84 152 C88 176 112 176 116 152" fill="none" stroke={INK} stroke-width="1.8" />
              <circle cx="100" cy="170" r="2.6" fill={INK} />
            </g>
          )}
          {who === 'theo' && (
            <g>
              <path d="M84 152 C88 178 112 178 116 152" fill="none" stroke="#c8c8c8" stroke-width="1.6" stroke-dasharray="2 1.4" />
              <path d="M100 172 L104 178 L100 184 L96 178 Z" fill="#c8c8c8" />
            </g>
          )}
          <g class="head">
            {/* Ears */}
            <ellipse cx="68" cy="94" rx="6" ry="9" fill={SKIN_SHADE} />
            <ellipse cx="132" cy="94" rx="6" ry="9" fill={SKIN_SHADE} />
            {/* Face */}
            <path d="M70 84 C70 58 84 46 100 46 C116 46 130 58 130 84 C130 108 120 132 100 134 C80 132 70 108 70 84 Z" fill={SKIN} />
            {/* Beard shadow / goatee */}
            {who === 'dylan' && <path d="M76 108 C82 128 118 128 124 108 C120 126 110 134 100 134 C90 134 80 126 76 108 Z" fill={SKIN_SHADE} opacity="0.7" />}
            {who === 'theo' && <path d="M92 126 C94 133 106 133 108 126 C106 130 94 130 92 126 Z M96 128 L104 128 L102 134 L98 134 Z" fill="#5b3b23" />}
            {/* Eyebrows */}
            <path
              d={who === 'margot' ? 'M80 80 C84 76 90 76 94 79 M106 79 C110 76 116 76 120 80' : 'M79 80 C84 76 90 76 95 78 M105 78 C110 76 116 76 121 80'}
              fill="none"
              stroke={who === 'dylan' ? '#c9a46a' : '#5b3b23'}
              stroke-width="3"
              stroke-linecap="round"
            />
            {/* Eyes */}
            <g class="eyes">
              <g class="eye"><ellipse cx="87" cy="90" rx="3.4" ry="4" fill={INK} /><circle class="glint" cx="88.2" cy="88.8" r="1" fill="#fff" /></g>
              <g class="eye"><ellipse cx="113" cy="90" rx="3.4" ry="4" fill={INK} /><circle class="glint" cx="114.2" cy="88.8" r="1" fill="#fff" /></g>
            </g>
            {/* Nose */}
            <path d="M100 92 L97 106 C99 108 102 108 104 106" fill="none" stroke={SKIN_SHADE} stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
            {/* Smile */}
            <path d="M86 113 C90 124 110 124 114 113 Z" fill="#fff" stroke={INK} stroke-width="2.2" stroke-linejoin="round" />
            {who === 'margot' && (
              <g fill="#e8b4a0" opacity="0.6">
                <ellipse cx="80" cy="106" rx="6" ry="3.5" />
                <ellipse cx="120" cy="106" rx="6" ry="3.5" />
              </g>
            )}
            {/* Hair */}
            {who === 'dylan' && (
              <path
                d="M68 90 C62 74 62 60 68 52 L60 42 L76 44 L74 28 L90 38 L96 20 L106 36 L120 24 L120 42 L138 36 L132 54 C138 64 136 78 132 90 C129 78 125 70 118 66 C104 70 86 68 76 66 C72 72 70 80 68 90 Z"
                fill="#ecd58f"
              />
            )}
            {who === 'dylan' && <path d="M76 44 L86 58 M96 22 L99 52 M120 26 L112 54 M134 40 L124 56" stroke="#d1b264" stroke-width="2" stroke-linecap="round" />}
            {who === 'theo' && (
              <g>
                {/* Short textured curls, darker at the roots, sun-bleached at the tips */}
                <path
                  d="M68 88 C64 74 66 62 72 56 C70 48 76 42 82 42 C84 36 92 32 98 36 C102 30 112 30 116 36 C122 34 130 40 130 46 C136 50 138 58 134 64 C136 72 134 80 132 88 C130 78 126 72 120 68 C106 64 92 64 80 68 C74 72 70 80 68 88 Z"
                  fill="#6b4a2e"
                />
                <path
                  d="M76 52 C78 46 84 44 88 46 M90 40 C94 36 100 36 102 40 M106 38 C110 34 116 36 118 40 M120 46 C124 44 128 48 128 52 M84 56 C88 52 94 52 96 56 M102 52 C106 48 112 50 114 54"
                  fill="none"
                  stroke="#d2ad72"
                  stroke-width="3"
                  stroke-linecap="round"
                />
              </g>
            )}
            {who === 'margot' && (
              <path
                d="M100 40 C78 40 64 56 64 82 C64 100 62 114 58 126 C66 112 70 98 72 80 C74 66 86 56 98 54 L100 58 L102 54 C114 56 126 66 128 80 C130 98 134 112 142 126 C138 114 136 100 136 82 C136 56 122 40 100 40 Z"
                fill="#9a6440"
              />
            )}
          </g>
        </g>
      )
    }
    </g>
  </g>
  <circle cx="100" cy="100" r="97.5" fill="none" stroke={GOLD} stroke-width="1.5"></circle>
</svg>

<style>
  .avatar {
    --ex: 0;
    --ey: 0;
    --hx: 0;
    display: block;
    overflow: visible;
  }
  .head {
    transform-box: view-box;
    transform-origin: 100px 150px;
    transform: rotate(calc(var(--hx) * 4deg));
    transition: transform 600ms var(--ease-out-strong);
  }
  .eyes {
    transform: translate(calc(var(--ex) * 2.4px), calc(var(--ey) * 1.8px));
    transition: transform 300ms var(--ease-out-strong);
  }
  .eye {
    transform-box: fill-box;
    transform-origin: center;
    animation: blink 5.2s infinite;
  }
  .avatar-theo .eye {
    animation-delay: 1.3s;
    animation-duration: 6.1s;
  }
  .avatar-margot .eye {
    animation-delay: 2.4s;
    animation-duration: 4.7s;
  }
  .avatar-pop .eye {
    animation-delay: 0.6s;
    animation-duration: 3.9s;
  }
  @keyframes blink {
    0%,
    95%,
    100% {
      transform: scaleY(1);
    }
    97% {
      transform: scaleY(0.1);
    }
  }
  .tongue {
    transform-box: fill-box;
    transform-origin: 50% 0;
    animation: pant 0.9s ease-in-out infinite alternate;
  }
  @keyframes pant {
    to {
      transform: scaleY(1.18);
    }
  }
  .ear {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transition: transform 300ms var(--ease-out-strong);
  }

  @media (prefers-reduced-motion: reduce) {
    .head,
    .eyes {
      transform: none;
      transition: none;
    }
    .eye,
    .tongue {
      animation: none;
    }
  }
</style>
