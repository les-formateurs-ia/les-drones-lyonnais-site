---
// A team member's portrait: their real photo, cut out, on the brand's ink disc with a
// gold ring, inside the camera's viewfinder marks. Black and white at rest; it takes its
// colours back when the member is "in focus" (an ancestor with [data-active] or a
// revealed [data-reveal].is-in) — the brand's original photo treatment.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photo: ImageMetadata;
  alt: string;
  class?: string;
}
const { photo, alt, class: className } = Astro.props;
---

<div class:list={['portrait viewfinder', className]} style={{ '--vf': 'var(--color-ink)', '--vf-inset': '0px', '--vf-size': '18px' }}>
  <div class="disc">
    <Image src={photo} alt={alt} widths={[240, 400, 640]} sizes="(min-width: 1024px) 380px, 140px" class="shot" />
  </div>
</div>

<style>
  .portrait {
    --px: 0;
    --py: 0;
    aspect-ratio: 1;
    padding: 10%;
  }
  .disc {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 35%, #2a2a2a, #0d0d0d 70%);
    box-shadow:
      0 0 0 1.5px var(--color-gold),
      0 0 0 6px var(--color-paper),
      0 0 0 7px rgb(175 133 74 / 0.35);
  }
  .shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08) brightness(0.95);
    transform: translate(calc(var(--px) * 6px), calc(var(--py) * 4px)) scale(1.02);
    transition:
      filter 800ms var(--ease-out-strong),
      transform 500ms var(--ease-out-strong);
  }
  :global([data-active]) .shot,
  :global([data-reveal].is-in) .shot {
    filter: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .shot {
      transform: none;
      transition: filter 300ms ease;
    }
  }
</style>
