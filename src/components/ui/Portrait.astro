---
// A team member's portrait: their own avatar photo, on the brand's ink disc with a gold
// ring, inside the camera's viewfinder marks. The photo comes alive in WebGL
// (lib/live-portrait.ts: breathing, blinking, looking around); the plain photo shows
// until then, and stays without WebGL or with reduced motion. Under the pointer
// (--px/--py, set by the page) the disc also tilts slightly in 3D.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { PortraitRig } from '../../lib/live-portrait';

interface Props {
  photo: ImageMetadata;
  alt: string;
  rig?: PortraitRig;
  class?: string;
}
const { photo, alt, rig, class: className } = Astro.props;
const texture = rig ? await getImage({ src: photo, width: 768, format: 'webp' }) : null;
---

<div class:list={['portrait viewfinder', className]} style={{ '--vf': 'var(--color-ink)', '--vf-inset': '0px', '--vf-size': '18px' }}>
  <div class="disc">
    <Image src={photo} alt={alt} widths={[240, 400, 640]} sizes="(min-width: 1024px) 380px, 140px" class="shot" />
    {rig && texture && <canvas class="shot live" data-rig={JSON.stringify(rig)} data-src={texture.src} aria-hidden="true" />}
  </div>
</div>

<style>
  .portrait {
    --px: 0;
    --py: 0;
    aspect-ratio: 1;
    padding: 10%;
    perspective: 900px;
  }
  .disc {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 50%;
    background: radial-gradient(circle at calc(50% + var(--px) * 18%) calc(32% + var(--py) * 14%), #3a3a3a, #0d0d0d 68%);
    box-shadow:
      0 0 0 1.5px var(--color-gold),
      0 0 0 6px var(--color-paper),
      0 0 0 7px rgb(175 133 74 / 0.35);
    transform: rotateY(calc(var(--px) * 9deg)) rotateX(calc(var(--py) * -9deg));
    transition: transform 600ms var(--ease-out-strong);
  }
  .live {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 400ms ease;
  }
  .live:global(.is-live) {
    opacity: 1;
  }
  .shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translate(calc(var(--px) * 10px), calc(var(--py) * 7px)) scale(1.05);
    transition: transform 600ms var(--ease-out-strong);
  }
  @media (prefers-reduced-motion: reduce) {
    .disc,
    .shot {
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import { initLivePortraits } from '../../lib/live-portrait';
  initLivePortraits();
</script>
