---
// A team portrait traced from its photo at build time (lib/trace-portrait.ts).
// When its card is revealed, the tone layers print one after the other, sliding
// into register; under a pointer, the layers shift by depth and the portrait tilts.
import { tracePortrait } from '../../lib/trace-portrait';

interface Props {
  /** File name in src/assets/team */
  file: string;
  class?: string;
}
const { file, class: className } = Astro.props;
const { viewBox, layers } = await tracePortrait(file);

// Where each layer starts before sliding into register, in viewBox units.
const OFFSETS = [
  [-7, 5],
  [6, -4],
  [-4, -6],
  [5, 6],
  [0, -8],
];
---

<div class:list={['portrait', className]} aria-hidden="true">
  <svg viewBox={viewBox} class="h-full w-full overflow-visible">
    {
      layers.map((layer, i) => (
        <g
          class="layer"
          fill={layer.color}
          stroke={layer.color}
          stroke-width="0.8"
          stroke-linejoin="round"
          style={{ '--l': i + 1, '--ox': `${OFFSETS[i % OFFSETS.length][0]}px`, '--oy': `${OFFSETS[i % OFFSETS.length][1]}px` }}
        >
          {layer.paths.map((d) => <path d={d} />)}
        </g>
      ))
    }
  </svg>
</div>

<style>
  .portrait {
    --mx: 0;
    --my: 0;
  }
  .portrait svg {
    transform: perspective(600px) rotateY(calc(var(--mx) * 14deg)) rotateX(calc(var(--my) * -14deg));
    transition: transform 500ms var(--ease-out-strong);
  }
  /* Parallax uses `transform`, the print-in uses `translate`: two properties, so the
     reveal's delays never slow down the pointer response. */
  .layer {
    transform: translate(calc(var(--mx) * var(--l) * 1.6px), calc(var(--my) * var(--l) * 1.6px));
    transition:
      transform 500ms var(--ease-out-strong),
      translate 900ms var(--ease-out-strong),
      opacity 500ms ease;
    transition-delay: 0ms, calc(150ms + var(--l) * 150ms), calc(150ms + var(--l) * 150ms);
  }
  :global(.js) :global([data-reveal]:not(.is-in)) .layer {
    opacity: 0;
    translate: var(--ox) var(--oy);
  }

  @media (prefers-reduced-motion: reduce) {
    .portrait svg,
    .layer {
      transform: none;
      transition: opacity 300ms ease;
    }
    :global(.js) :global([data-reveal]:not(.is-in)) .layer {
      translate: none;
    }
  }
</style>
