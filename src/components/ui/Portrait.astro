---
// A team member's portrait: their own avatar photo (cut out, upscaled and sharpened),
// on the brand's ink disc with a gold ring, inside the camera's viewfinder marks.
// Under the pointer (--px/--py, set by the page) the disc tilts slightly in 3D and the
// person shifts a little more than the disc, which gives it depth.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photo: ImageMetadata;
  alt: string;
  class?: string;
}
const { photo, alt, class: className } = Astro.props;
---

<div class:list={['portrait viewfinder', className]} style={{ '--vf': 'var(--color-ink)', '--vf-inset': '0px', '--vf-size': '18px' }}>
  <div class="disc">
    <Image src={photo} alt={alt} widths={[240, 400, 640]} sizes="(min-width: 1024px) 380px, 140px" class="shot" />
  </div>
</div>

<style>
  .portrait {
    --px: 0;
    --py: 0;
    aspect-ratio: 1;
    padding: 10%;
    perspective: 900px;
  }
  .disc {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 50%;
    background: radial-gradient(circle at calc(50% + var(--px) * 18%) calc(32% + var(--py) * 14%), #3a3a3a, #0d0d0d 68%);
    box-shadow:
      0 0 0 1.5px var(--color-gold),
      0 0 0 6px var(--color-paper),
      0 0 0 7px rgb(175 133 74 / 0.35);
    transform: rotateY(calc(var(--px) * 9deg)) rotateX(calc(var(--py) * -9deg));
    transition: transform 600ms var(--ease-out-strong);
  }
  .shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translate(calc(var(--px) * 10px), calc(var(--py) * 7px)) scale(1.05);
    transition: transform 600ms var(--ease-out-strong);
  }
  @media (prefers-reduced-motion: reduce) {
    .disc,
    .shot {
      transform: none;
      transition: none;
    }
  }
</style>
